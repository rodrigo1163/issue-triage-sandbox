generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TriageStatus {
  RECEIVED
  QUEUED
  HUMAN_REVIEW
}

enum HumanReviewReason {
  UNKNOWN_REPOSITORY
  MISSING_DESCRIPTION
}

model IssueTriage {
  id      String @id @default(cuid())
  eventId String @unique

  repository  String
  issueNumber Int
  title       String
  description String?
  occurredAt  DateTime

  status            TriageStatus      @default(RECEIVED)
  humanReviewReason HumanReviewReason?
  sqsMessageId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repository, issueNumber])
  @@index([status])
}

model ProjectCatalog {
  id                 String   @id @default(cuid())
  repository         String   @unique
  responsibles       String[] @default([])
  triageInstructions String[] @default([])
  active             Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
